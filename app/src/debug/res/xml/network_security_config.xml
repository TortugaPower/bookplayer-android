<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only network security config. Permits cleartext (HTTP) to local development
    hosts so the dev flavor can hit a server running on your machine. This override
    replaces the main config for debug builds only; release builds use the locked-down
    main config (HTTPS-only, system trust anchors).

    Add your own local dev host here (LAN IP, Tailscale name, etc.) — it never reaches
    a release/Play build.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain> <!-- Android Emulator loopback -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">192.168.100.169</domain> <!-- LAN dev host -->
        <domain includeSubdomains="true">giannis-macbook-pro.whale-escalator.ts.net</domain> <!-- Tailscale dev host -->
        <domain includeSubdomains="true">ds224plus.whale-escalator.ts.net</domain> <!-- Tailscale NAS (Jellyfin/ABS) -->
    </domain-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
