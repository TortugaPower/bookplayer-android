<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keeps the CPU and (for streamed books) the Wi-Fi radio awake so audio keeps playing with the
         screen off / during doze (paired with ExoPlayer.setWakeMode(WAKE_MODE_NETWORK) in
         AudioPlayerService). The Wi-Fi lock also only needs WAKE_LOCK — no extra permission. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Lets us resolve/launch email apps (package visibility, API 30+) for the support email. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:name=".BookPlayerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BookPlayer"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">
        <!--
            Disable Sentry's auto-init ContentProvider. We init manually in
            BookPlayerApplication.onCreate() so we can read the DSN from BuildConfig
            (sourced from local.properties) and skip init when it's empty.
        -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />
        <!--
            MainActivity is the single real launch target. The MAIN/LAUNCHER entry point lives on the
            <activity-alias> entries below (one per app icon) instead of here, so switching the app
            icon — which toggles those aliases via PackageManager.setComponentEnabledSetting — never
            disables the deep-link (bookplayer://) filter or the app's entry. MainActivity itself is
            never disabled. See AppIconManager.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.App.Starting"
            android:launchMode="singleTop"
            android:configChanges="uiMode|orientation|screenSize">
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bookplayer" />
            </intent-filter>
            <!--
                "Open with" / view an audio file shared from another app (a chat, a file manager,
                etc.). Makes BookPlayer appear in the chooser for audio files; MainActivity.handleIntent
                routes the incoming content://-or-file:// URI into ImportManager. CATEGORY_DEFAULT is
                required for the chooser; no BROWSABLE (this is for files, not web links).
            -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <!--
                "Share" one or more audio files TO BookPlayer (system Share sheet). The file(s) ride
                in EXTRA_STREAM, not the intent data — MainActivity.handleIntent reads them and routes
                into ImportManager. SEND = one file, SEND_MULTIPLE = a batch.
            -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!--
            App-icon aliases. Each is a launcher entry pointing at MainActivity with its own icon;
            exactly one is enabled at a time (Default by default). AppIconManager enables the chosen
            alias and disables the rest. The android:name suffix (".icon.<Id>") must match AppIcon.id,
            and each android:icon mipmap matches the AppIcon's previewRes.
        -->
        <activity-alias
            android:name=".icon.Default"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Retro"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_retro"
            android:roundIcon="@mipmap/ic_launcher_retro_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.FruitBased"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_fruit_based"
            android:roundIcon="@mipmap/ic_launcher_fruit_based_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.RetroModern"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_retro_modern"
            android:roundIcon="@mipmap/ic_launcher_retro_modern_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Neon"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_neon"
            android:roundIcon="@mipmap/ic_launcher_neon_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.AyuLight"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_ayu_light"
            android:roundIcon="@mipmap/ic_launcher_ayu_light_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Songs"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_songs"
            android:roundIcon="@mipmap/ic_launcher_songs_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".service.AudioPlayerService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <!-- Legacy MediaBrowserService action: how Android Auto DISCOVERS a media app. Media3's
                     MediaLibraryService serves this protocol too but doesn't add the action itself. -->
                <action android:name="android.media.browse.MediaBrowserService" />
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <!-- Declares this app as an Android Auto media app (browse tree via the MediaLibraryService above). -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <service
            android:name=".logic.TaskConcurrencyServiceHost"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Answers the Wear app's sign-in handoff request over the Data Layer. Exported because the
             system (Google Play services) binds it to deliver MESSAGE_RECEIVED events. -->
        <service
            android:name=".wear.WearAuthListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/bookplayer/auth" />
            </intent-filter>
        </service>

        <!-- Receives remote-controller playback commands from the watch and drives PlaybackManager. -->
        <service
            android:name=".wear.WearCommandListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/bookplayer/command" />
            </intent-filter>
        </service>


        <!-- App Widget Large Provider registration. Not exported: the system delivers
             APPWIDGET_UPDATE with system privilege, and the playback-control actions arrive via
             this app's own explicit PendingIntents — keeping them out of the intent-filter and
             the receiver private stops other apps from driving playback. -->
        <receiver
            android:name=".widget.AudioWidgetLargeProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/audio_widget_large_info" />
        </receiver>

        <!-- App Widget Large Service registration -->
        <service
            android:name=".widget.AudioWidgetLargeService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />


        <!-- Shares the generated debug .txt as a content:// URI (Settings → Support). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>