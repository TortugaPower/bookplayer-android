<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Lets us resolve/launch email apps (package visibility, API 30+) for the support email. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:name=".BookPlayerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BookPlayer"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">
        <!--
            Disable Sentry's auto-init ContentProvider. We init manually in
            BookPlayerApplication.onCreate() so we can read the DSN from BuildConfig
            (sourced from local.properties) and skip init when it's empty.
        -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />
        <!--
            MainActivity is the single real launch target. The MAIN/LAUNCHER entry point lives on the
            <activity-alias> entries below (one per app icon) instead of here, so switching the app
            icon — which toggles those aliases via PackageManager.setComponentEnabledSetting — never
            disables the deep-link (bookplayer://) filter or the app's entry. MainActivity itself is
            never disabled. See AppIconManager.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.App.Starting"
            android:launchMode="singleTop"
            android:configChanges="uiMode|orientation|screenSize">
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bookplayer" />
            </intent-filter>
        </activity>

        <!--
            App-icon aliases. Each is a launcher entry pointing at MainActivity with its own icon;
            exactly one is enabled at a time (Default by default). AppIconManager enables the chosen
            alias and disables the rest. The android:name suffix (".icon.<Id>") must match AppIcon.id.
            Alternates reference placeholder mipmaps until their real art is generated (see the
            mipmap-anydpi-v26/ic_launcher_* comments).
        -->
        <activity-alias
            android:name=".icon.Default"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Retro"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_retro"
            android:roundIcon="@mipmap/ic_launcher_retro_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.FruitBased"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_fruit_based"
            android:roundIcon="@mipmap/ic_launcher_fruit_based_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.RetroModern"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_retro_modern"
            android:roundIcon="@mipmap/ic_launcher_retro_modern_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Neon"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_neon"
            android:roundIcon="@mipmap/ic_launcher_neon_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.AyuLight"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_ayu_light"
            android:roundIcon="@mipmap/ic_launcher_ayu_light_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Songs"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_songs"
            android:roundIcon="@mipmap/ic_launcher_songs_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".service.AudioPlayerService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <service
            android:name=".logic.TaskConcurrencyServiceHost"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Shares the generated debug .txt as a content:// URI (Settings → Support). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>