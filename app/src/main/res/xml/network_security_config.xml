<?xml version="1.0" encoding="utf-8"?>
<!--
    Release/default network security config: HTTPS-only, system trust anchors.
    Local development cleartext hosts are defined in the debug override at
    app/src/debug/res/xml/network_security_config.xml and never apply here.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
