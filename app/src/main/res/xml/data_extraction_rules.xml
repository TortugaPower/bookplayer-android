<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- The library sync's state (SyncStateStore): a restored install must sync like a fresh one -->
    <cloud-backup>
        <exclude domain="file" path="datastore/sync_state.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/sync_state.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>