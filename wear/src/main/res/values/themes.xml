<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Wear Compose draws its own surfaces; the activity only needs a bare, action-bar-less
         DeviceDefault theme with a black window background (the standard Wear OS baseline). -->
    <style name="Theme.BookPlayerWear" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Branded launch (Wear App Quality Guidelines / Play review "Missing app icon in splash
         screen"): cold start must show the app icon on a black background. The SplashScreen
         library renders the launcher icon, then hands over to the regular theme. -->
    <style name="Theme.BookPlayerWear.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.BookPlayerWear</item>
    </style>
</resources>
