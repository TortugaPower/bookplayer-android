# Copy this file to `keystore.properties` and fill in the values.
# `keystore.properties` is gitignored.
#
# These values are required only for signing release builds. Debug builds use the
# Android Studio debug keystore automatically and need nothing here.
#
# Every key below is also read from the environment (e.g. CI), so you can leave the
# file uncommitted on your machine and inject the values via env vars in CI.

# Path to the keystore, relative to the project root (where settings.gradle.kts lives).
RELEASE_STORE_FILE=app/bookplayer-upload.keystore

RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=bookplayer-upload
RELEASE_KEY_PASSWORD=
